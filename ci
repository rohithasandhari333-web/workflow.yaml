name: CI (fastapi-demo)

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
  workflow_dispatch:

jobs:
  test:
    name: Test FastAPI Application
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Test FastAPI
        run: |
          python -c "from main import app; print('FastAPI application loaded successfully')"

      - name: Build Docker Image
        run: |
          docker build -t fastapi-demo:${{ github.sha }} .

      - name: CI Success
        run: echo "CI completed successfully"
